#include <dt-bindings/zmk/mouse.h>
#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

// NOTE: the two #defines below are currently inert. They only set the default
// per-tick amount for ZMK's KEY-DRIVEN mouse-move (&mmv) / mouse-scroll (&msc)
// behaviors, and nothing on this board binds those (and there is no physical
// encoder). Left defined because ZMK references the symbols, but they have no
// effect on the physical trackball (whose speed is CONFIG_PMW3610_CPI).
#define ZMK_POINTING_DEFAULT_MOVE_VAL 1000 // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 12   // 10

// Trackball snipe (slow/precise) and sway (fast) layers. Held via the home-row
// combos (k+l / j+k) and consumed by the &trackball_listener overrides below.
// These numbers MUST match the layers' order in the keymap node further down
// (snipe = 6th layer = index 5, sway = 7th layer = index 6).
#define SNIPE_LAYER 5
#define SWAY_LAYER  6

&lt {
    tapping-term-ms = <200>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

/*
 * ---------------------------------------------------------------------------
 * DEAD WEIGHT (commented out) — none of this touched the physical trackball.
 *
 *  - &mmv_input_listener / &msc_input_listener: the input pipelines for ZMK's
 *    KEY-DRIVEN mouse-move (&mmv) and mouse-scroll (&msc) behaviors. The
 *    zip_*_scaler doubled their speed. But no key binds &mmv, and &msc was only
 *    produced by the encoder (knob) behaviors below — which this board doesn't
 *    physically have. So these scalers never affected anything.
 *  - &msc / &mmv: acceleration / speed-ramp tuning for those same key-driven
 *    behaviors. Inert for the same reason.
 *
 * The physical trackball is a SEPARATE device (&trackball_listener); its base
 * speed is CONFIG_PMW3610_CPI (charybdis_right.conf), and it is scaled for
 * snipe / sway by the overrides immediately below.
 * ---------------------------------------------------------------------------
 */
// &mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };
//
// &msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };
//
// &msc {
//     acceleration-exponent = <0>;      // 0
//     time-to-max-speed-ms = <100>;       // 300
//     delay-ms = <0>;                   // 0
// };
//
// &mmv {
//     time-to-max-speed-ms = <300>;
//     acceleration-exponent = <1>;
//     trigger-period-ms = <16>;
// };

/*
 * SNIPE / SWAY — scale the PHYSICAL trackball's pointer movement.
 *
 * Per-layer overrides on the trackball's own input listener. While the snipe
 * or sway layer is held (via the home-row combos), the matching scaler is
 * applied to the trackball's X/Y before it becomes HID movement:
 *   - snipe (k+l): x1/3  -> slower & precise (e.g. selecting text)
 *   - sway  (j+k): x2/1  -> faster, to cross the screen quickly
 * zip_xy_scaler tracks remainders, so sub-step motion is not lost. This is
 * pointer-only (scrolling is not affected). Tune the <mult div> pairs to taste.
 */
&trackball_listener {
    snipe {
        layers = <SNIPE_LAYER>;
        input-processors = <&zip_xy_scaler 1 3>;
    };

    sway {
        layers = <SWAY_LAYER>;
        input-processors = <&zip_xy_scaler 2 1>;
    };
};

/ {
    /*
     * DEAD WEIGHT (commented out): rotary-encoder (knob) scroll behaviors.
     * This board has no physical encoder, so these never ran. Originally:
     *   scroll_vertical_encoder   = knob -> vertical scroll   (上下滚动)
     *   scroll_horizontal_encoder = knob -> horizontal scroll (左右滚动)
     * Each turned encoder rotation into &msc scroll events. The per-layer
     * `sensor-bindings` that referenced them are commented out too (below).
     *
     * scroll_vertical_encoder: scroll_vertical_encoder {
     *     compatible = "zmk,behavior-sensor-rotate";
     *     sensor-binding-cells = <0>;
     *     bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;
     *     tap-ms = <100>;
     * };
     * scroll_horizontal_encoder: scroll_horizontal_encoder {
     *     compatible = "zmk,behavior-sensor-rotate";
     *     sensor-binding-cells = <0>;
     *     bindings = <&msc SCRL_LEFT>, <&msc SCRL_RIGHT>;
     *     tap-ms = <100>;
     * };
     */

    behaviors {
    };

    combos {
        compatible = "zmk,combos";

        combo_left_brace {
            bindings = <&kp LEFT_BRACE>;
            key-positions = <48 9 24>;
            timeout-ms = <50>;
            layers = <0>;
        };

        combo_right_brace {
            bindings = <&kp RIGHT_BRACE>;
            key-positions = <48 10 24>;
            timeout-ms = <50>;
            layers = <0>;
        };

        combo_left_bracket {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <48 44 24>;
            timeout-ms = <50>;
            layers = <0>;
        };

        combo_right_bracket {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <48 45 24>;
            timeout-ms = <50>;
            layers = <0>;
        };

        combo_equal {
            bindings = <&kp KP_EQUAL>;
            key-positions = <44 45>;
            timeout-ms = <50>;
            layers = <0>;
        };

        combo_plus {
            bindings = <&kp KP_PLUS>;
            key-positions = <48 47>;
            timeout-ms = <50>;
            layers = <0>;
        };

        ER {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <24 43>;
            timeout-ms = <50>;
            layers = <3>;
        };

        combo_to_rus {
            bindings = <&to 3>;
            key-positions = <50 51>;
            layers = <0>;
        };

        combo_from_rus {
            bindings = <&to 0>;
            key-positions = <50 51>;
            layers = <3>;
        };

        // Trackball speed combos (right home row), held momentarily:
        //   j+k (positions 31 32) -> "sway"  = faster pointer
        //   k+l (positions 32 33) -> "snipe" = slower / precise pointer
        // require-prior-idle-ms keeps them from firing during fast typing
        // rolls; scoped to layer 0. See the &trackball_listener overrides above.
        combo_sway {
            bindings = <&mo SWAY_LAYER>;
            key-positions = <31 32>;
            timeout-ms = <50>;
            require-prior-idle-ms = <125>;
            layers = <0>;
        };

        combo_snipe {
            bindings = <&mo SNIPE_LAYER>;
            key-positions = <32 33>;
            timeout-ms = <50>;
            require-prior-idle-ms = <125>;
            layers = <0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
&kp ESC         &kp N1  &kp N2  &kp N3        &kp N4     &kp N5      &kp N6        &kp N7     &kp N8     &kp N9   &kp N0    &kp BACKSPACE
&kp TAB         &kp Q   &kp W   &kp E         &kp R      &kp T       &kp Y         &kp U      &kp I      &kp O    &kp P     &kp BSLH
&sk LEFT_SHIFT  &kp A   &kp S   &kp D         &kp F      &kp G       &kp H         &kp J      &kp K      &kp L    &kp SEMI  &kp SQT
&kp LCTRL       &kp Z   &kp X   &kp C         &kp V      &kp B       &kp N         &kp M      &kp COMMA  &kp DOT  &kp FSLH  &kp MINUS
                                &kp LEFT_ALT  &kp SPACE  &to 1       &to 2         &kp ENTER
                                              &mkp MB1   &mkp MB2    &kp LEFT_GUI
            >;

            /* DEAD WEIGHT (no physical encoder): mapped knob rotation to
             * scroll (encoder1 = vertical 上下, encoder2 = horizontal 左右).
             * Disabled along with the scroll_*_encoder behaviors above.
            sensor-bindings =
                <&scroll_vertical_encoder>,
                <&scroll_horizontal_encoder>;
            */
        };

        navigation_mouse {
            bindings = <
&kp F1          &kp F2  &kp F3    &kp F4         &kp F5     &kp F6      &kp F7        &kp F8     &kp F9    &kp F10    &kp F11  &kp F12
&kp TAB         &none   &kp HOME  &kp PG_UP      &kp END    &none       &none         &none      &kp UP    &none      &none    &bt BT_CLR
&sk LEFT_SHIFT  &none   &none     &kp PAGE_DOWN  &none      &none       &none         &kp LEFT   &kp DOWN  &kp RIGHT  &none    &bt BT_NXT
&kp LCTRL       &none   &none     &none          &none      &none       &tog 4        &mkp MB1   &mkp MB2  &mkp MB3   &none    &kp DELETE
                                  &kp LEFT_ALT   &kp SPACE  &to 0       &none         &kp ENTER
                                                 &mkp MB1   &mkp MB2    &kp LEFT_GUI
            >;
        };

        numbers {
            bindings = <
&kp ESC    &kp EXCLAMATION  &kp AT_SIGN   &kp HASH      &kp DOLLAR    &kp PERCENT             &kp CARET              &kp AMPERSAND  &kp ASTERISK  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp BACKSPACE
&kp TAB    &kp TILDE        &kp N7        &kp N8        &kp N9        &kp LEFT_PARENTHESIS    &kp RIGHT_PARENTHESIS  &kp SLASH      &none         &kp ASTERISK          &kp GRAVE              &kp BACKSLASH
&sk LSHFT  &kp N0           &kp NUMBER_4  &kp N5        &kp NUMBER_6  &kp LEFT_BRACKET        &kp RIGHT_BRACKET      &kp MINUS      &kp EQUAL     &kp PLUS              &kp SEMICOLON          &kp SQT
&kp LCTRL  &trans           &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp LEFT_BRACE          &kp RIGHT_BRACE        &none          &kp COMMA     &kp DOT               &kp SLASH              &kp DELETE
                                          &kp LEFT_ALT  &kp SPACE     &none                   &to 0                  &kp ENTER
                                                        &mkp MB1      &mkp MB2                &kp LEFT_GUI
            >;

            /* DEAD WEIGHT (no physical encoder): mapped knob rotation to
             * scroll (encoder1 = vertical 上下, encoder2 = horizontal 左右).
             * Disabled along with the scroll_*_encoder behaviors above.
            sensor-bindings =
                <&scroll_vertical_encoder>,
                <&scroll_horizontal_encoder>;
            */
        };

        rus {
            bindings = <
&kp ESC         &kp N1  &kp N2  &kp N3        &kp N4     &kp N5      &kp N6        &kp N7     &kp N8     &kp N9   &kp N0    &kp BACKSPACE
&kp TAB         &kp Q   &kp W   &kp E         &kp R      &kp T       &kp Y         &kp U      &kp I      &kp O    &kp P     &kp LEFT_BRACKET
&sk LEFT_SHIFT  &kp A   &kp S   &kp D         &kp F      &kp G       &kp H         &kp J      &kp K      &kp L    &kp SEMI  &kp SQT
&kp LCTRL       &kp Z   &kp X   &kp C         &kp V      &kp B       &kp N         &kp M      &kp COMMA  &kp DOT  &kp FSLH  &kp MINUS
                                &kp LEFT_ALT  &kp SPACE  &none       &none         &kp ENTER
                                              &mkp MB1   &mkp MB2    &kp LEFT_GUI
            >;

            /* DEAD WEIGHT (no physical encoder): knob -> scroll mapping,
             * disabled along with the scroll_*_encoder behaviors above.
            sensor-bindings =
                <&scroll_vertical_encoder>,
                <&scroll_horizontal_encoder>;
            */
        };

        mouse_conditional {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &trans  &trans
                                &trans  &trans    &trans
            >;

            /* DEAD WEIGHT (no physical encoder): knob -> scroll mapping,
             * disabled along with the scroll_*_encoder behaviors above.
            sensor-bindings =
                <&scroll_vertical_encoder>,
                <&scroll_horizontal_encoder>;
            */
        };

        // Snipe layer (index 5): fully transparent so all normal keys keep
        // working while held. Its only job is to be "active" so the trackball
        // snipe scaler (1/3) kicks in. Held via the k+l combo.
        snipe_layer {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &trans  &trans
                                &trans  &trans    &trans
            >;
        };

        // Sway layer (index 6): same idea, activates the sway scaler (2x).
        // Held via the j+k combo.
        sway_layer {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &trans  &trans
                                &trans  &trans    &trans
            >;
        };

        /* layer_2 {
            bindings = <
&none  &none   &none    &none   &none         &none         &kp N1         &none         &none     &none  &none   &to 0
&none  &none   &none    &none   &none         &none         &none         &none          &rgb_ug RGB_BRD &rgb_ug RGB_BRI  &rgb_ug RGB_EFF   &rgb_ug RGB_TOG
&none  &none   &none    &none   &none         &none         &none         &mkp LCLK     &mkp RCLK  &none  &none   &none
&none  &none   &none    &none   &bt BT_NXT  &bt BT_CLR    &none         &none         &none     &none  &none   &none
                                   &none         &none         &none         &none         &none
                                                 &none         &none         &none
            >;
       
            
        };

       Mouse {
            bindings = <
&none        &none         &none         &none         &none      &none         &none       &none      &none         &none         &none         &none
&none        &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 3  &none      &bt BT_CLR    &bt BT_CLR  &none      &bt BT_SEL 2  &bt BT_SEL 1  &bt BT_SEL 0  &none
&none        &trans        &trans        &mkp MCLK     &trans     &none         &none       &trans     &mkp MCLK     &trans        &trans        &none
&bootloader  &trans        &mkp RCLK     &mo 4         &mkp LCLK  &mo 5         &mo 5       &mkp LCLK  &mo 4         &mkp RCLK     &trans        &bootloader
                                         &mo 5         &mkp LCLK  &mkp RCLK     &mkp RCLK   &mkp LCLK
                                                       &none      &trans        &trans
            >;

            
        };

        layer_4 {
            bindings = <
&trans  &trans  &trans     &trans     &trans     &trans       &trans     &trans     &trans     &trans     &trans  &trans
&trans  &trans  &trans     &trans     &trans     &trans       &trans     &trans     &trans     &trans     &trans  &trans
&trans  &trans  &trans     &mkp MCLK  &trans     &trans       &trans     &trans     &mkp MCLK  &trans     &trans  &trans
&trans  &trans  &mkp RCLK  &trans     &mkp LCLK  &trans       &trans     &mkp LCLK  &trans     &mkp RCLK  &trans  &trans
                           &trans     &mkp LCLK  &mkp RCLK    &mkp RCLK  &mkp LCLK
                                      &trans     &trans       &trans
            >;
                
                
               
        };

        layer_5 {
            bindings = <
&trans  &trans  &trans     &trans     &trans     &trans       &trans     &trans     &trans     &trans     &trans  &trans
&trans  &trans  &trans     &trans     &trans     &trans       &trans     &trans     &trans     &trans     &trans  &trans
&trans  &trans  &trans     &mkp MCLK  &trans     &trans       &trans     &trans     &mkp MCLK  &trans     &trans  &trans
&trans  &trans  &mkp RCLK  &trans     &mkp LCLK  &trans       &trans     &mkp LCLK  &trans     &mkp RCLK  &trans  &trans
                           &trans     &mkp LCLK  &mkp RCLK    &mkp RCLK  &mkp LCLK
                                      &trans     &trans       &trans
            >;
                
                
        };*/
    };
};
